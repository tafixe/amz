# Local development template — copy to .env and fill. .env is gitignored.
# In production these are GitHub Secrets (see .github/SECURITY.md).

# --- Cloudflare ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
AMAZON_R2_BUCKET=ofertas-amazon

# --- Affiliate tags ---
AMAZON_AFFILIATE_TAG=default-tag
AMAZON_AFFILIATE_TAGS_JSON={"amazon.es":"xxx-21","amazon.com":"xxx-20"}

# --- Telegram / web sources (JSON) ---
AMAZON_TELEGRAM_CHANNELS_JSON=["channel_a"]
AMAZON_WEB_PAGES_JSON=[]

# --- All other source URLs/channels in ONE JSON blob (see SECURITY.md keys) ---
SOURCES_JSON={"chollo_pages":[],"chollo_visit_base":"","titas_proxy":"","titas_direct":"","cupo_api":"","dez_api":"","nas_proxy":"","nas_direct":"","descontos_channels":[],"deluxe_pages":[]}

# --- Optional price history ---
KEEPA_API_KEY=
KEEPA_DOMAIN=9
